{
  "permissions": {
    "deny": [
      "Edit(**/*.pbxproj)",
      "Edit(**/*.xcodeproj/**)",
      "Edit(**/*.xcworkspace/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-project-config.sh\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-before-pr.sh\"",
            "timeout": 900,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
