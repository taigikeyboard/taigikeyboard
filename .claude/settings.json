{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-project-config.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(git stash)",
      "Bash(git stash:*)"
    ]
  }
}
