{
  "manifest_version": 3,
  "name": "台語齒盤 ChromeOS：台語輸入法、台文輸入",
  "short_name": "TaigiKeyboard",
  "version": "3.9.0",
  "description": "免費、開源、跨裝置 ê 台灣話拍字家私",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "worker.js", "type": "module" },
  "permissions": ["input", "offscreen", "storage"],
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "input_components": [
    {
      "name": "台語齒盤",
      "type": "ime",
      "id": "taigi",
      "indicator": "台",
      "description": "TaigiKeyboard",
      "language": "zh-TW",
      "options_page": "options.html",
      "layouts": ["us"]
    }
  ]
}
