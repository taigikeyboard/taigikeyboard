<?xml version="1.0" encoding="UTF-8"?>
<!--
  The per-user scheduled task the installer registers (roadmap W9): the
  daily update check, headless — `TaigiKeyboardSettings.exe --check-updates`
  — five minutes after logon, then once a day. `@@COMMAND@@` is the installed
  exe's absolute path, filled in by the installer's [Code] section before
  `schtasks /Create /XML`. No principal user is named: schtasks registers the
  task for the user running it (the original, non-elevated user).
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Checks once a day whether a newer Taigi Keyboard is published.</Description>
    <URI>\TaigiKeyboard Update Check</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <Delay>PT5M</Delay>
    </LogonTrigger>
    <CalendarTrigger>
      <StartBoundary>2026-01-01T12:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
      <RandomDelay>PT1H</RandomDelay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="User">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT5M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="User">
    <Exec>
      <Command>@@COMMAND@@</Command>
      <Arguments>--check-updates</Arguments>
    </Exec>
  </Actions>
</Task>
