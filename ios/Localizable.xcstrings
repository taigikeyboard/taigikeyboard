    "i18n_home_freePromise": {
      "comment": "About-developer page body: the maintainer's promise that the keyboard stays free.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taigi Keyboard will always be free, with no paid features. Taiwanese is our mother tongue, and no one should be unable to use a good tool over money. My hope is that everyone who wants to learn and write Taiwanese can use it without any burden — that is the most important wish behind this keyboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台湾語キーボードは永久に無料で、有料機能を設けることはありません。台湾語は私たちの母語であり、お金のせいで良い道具が使えないことがあってはなりません。台湾語を学びたい、書きたいと願うすべての人が負担なく使えること——それがこのキーボードを作る上で最も大切な願いです。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "台語齒盤保證永遠免費，嘛袂做付費功能。台語是咱 ê 母語，無應該因為錢 ê 問題用袂著好家私。我向望逐家想欲學台語、寫台語 ê 人攏會當無負擔來使用，這是我做這个齒盤上重要 ê 心願。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "tâi-gí khí-pôaⁿ pó-chèng éng-oán bián-hùi， mā bōe chòe hù-hùi kong-lêng。 tâi-gí sī lán ê bó-gí， bô èng-kai in-ūi chîⁿ ê būn-tê iōng bōe tio̍h hó ke-si。 góa ǹg-bāng ta̍k-ke siūⁿ-beh ha̍k tâi-gí、 siá tâi-gí ê jîn láng ē-tàng bô hū-tam lâi sú-iōng， che-sī góa chòe chit ê khí-pôaⁿ siōng tiōng-iàu ê sim-goān。"
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "tâi-gí khí-puânn pó-tsìng íng-uán bián-huì， mā buē tsuè hù-huì kong-lîng。 tâi-gí sī lán ê bó-gí， bô ìng-kai in-uī tsînn ê būn-tê iōng buē tio̍h hó ke-si。 guá ǹg-bāng ta̍k-ke siūnn-beh ha̍k tâi-gí、 siá tâi-gí ê jîn láng ē-tàng bô hū-tam lâi sú-iōng， tse-sī guá tsuè tsit ê khí-puânn siōng tiōng-iàu ê sim-guān。"
          }
        }
      }
    },
