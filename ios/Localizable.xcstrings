    "i18n_settings_literalRomanCandidateInfo": {
      "comment": "Help text for the show-romanization toggle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Places the romanization in the first slot of the candidate bar; tap it or press Enter to commit. When off, you can only commit with Enter (tapping is disabled), but the candidate bar has more room."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補バーの先頭にローマ字を表示します。タップするか Enter で確定できます。オフにすると Enter でのみ確定でき（タップは無効）、その分候補バーが広くなります。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "候選詞列第一个位囥羅馬字，會當用手點抑是揤 Enter 送出，若關，干焦會當揤 Enter 送出，袂當用手點，但是候選詞列空間較大。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "hāu-soán sû lia̍t tē-it ê ūi khǹg lô-má-jī， ē-tàng iōng chhiú tiám ah-sī chhi̍h Enter sàng-chhut， nā koan， kan-taⁿ-ē-tàng chhi̍h Enter sàng-chhut， bōe-tàng iōng chhiú tiám， tān-sī hāu-soán sû lia̍t khang-keng khah-tōa。"
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "hāu-suán sû lia̍t tē-it ê uī khǹg lô-má-jī， ē-tàng iōng tshiú tiám ah-sī tshi̍h Enter sàng-tshut， nā kuan， kan-tann-ē-tàng tshi̍h Enter sàng-tshut， buē-tàng iōng tshiú tiám， tān-sī hāu-suán sû lia̍t khang-king khah-tōa。"
          }
        }
      }
