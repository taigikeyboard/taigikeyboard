    "i18n_dictionary_associationPrivacyWarning": {
      "comment": "Privacy warning about sharing word-association data for research.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Association records may reflect phrases you have typed. Check for sensitive content before exporting or sharing them. When recording is off, the keyboard stops learning your next-word habits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語連携の記録には、入力した語句が反映される場合があります。エクスポートや共有の前に、機密情報が含まれていないか確認してください。記録をオフにすると、次の単語の使い方を学習しなくなります。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "詞關聯紀錄可能會反映你拍過 ê 詞組。匯出抑是分享進前，請先檢查敏感內容。關閉紀錄了後，齒盤袂閣學習你的下一詞使用習慣。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "sû koan-liân kì-lio̍k khó-lêng ē hoán-èng lí phah kòe ê sû-cho͘. hōe-chhut ah-sī hun-hióng chìn-chêng, chhiáⁿ sian kiám-cha bín-kám lōe-iông. koaiⁿ--khí-lâi liáu-āu, khí-pôaⁿ bōe koh ha̍k-si̍p lí ê ē chi̍t ê sû sú-iōng si̍p-koàn."
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "sû kuan-liân kì-lio̍k khó-lîng ē huán-ìng lí phah kuè ê sû-tsoo. huē-tshut ah-sī hun-hióng tsìn-tsîng, tshiánn sian kiám-tsa bín-kám luē-iông. kuainn--khí-lâi liáu-āu, khí-puânn buē koh ha̍k-si̍p lí ê ē tsi̍t ê sû sú-iōng si̍p-kuàn."
          }
        }
      }
    },
    "i18n_dictionary_associationRecordingEnabled": {
      "comment": "Toggle label: enable recording of word-association (bigram) data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
