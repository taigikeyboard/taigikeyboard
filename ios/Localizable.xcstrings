    "i18n_dictionary_associationPrivacyWarning": {
      "comment": "Privacy warning about sharing word-association data for research.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Association records are valuable data for Taiwanese-language research. If you share them for research, please delete sensitive content first. You can also turn recording off, though next-word prediction will then be less accurate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語連携の記録は台湾語研究にとって貴重なデータです。研究のために提供する場合は、機密性の高い内容を先に削除してください。記録機能はオフにもできますが、その場合は次の単語の予測精度が下がります。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "詞關聯紀錄對台語研究來講是真有價值 ê 資料。若欲提供予人做研究，請先刪除敏感 ê 內容。紀錄功能嘛會使關起來，毋過後一詞預測會較無準。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "sû koan-liân kì-lio̍k tùi tâi-gí gián-kiù lâi kóng sī chin ū-kè ta̍t ê chu-liāu。 nā-beh thê-kiong hō͘-lâng chòe gián-kiù， chhiáⁿ sian san-tî bín-kám ê lōe-iông。 kì-lio̍k kong-lêng mā ē-sái koaiⁿ--khí-lâi， m̄-koh āu chi̍t sû ī-chhek hōe khah bô chún。"
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "sû kuan-liân kì-lio̍k tuì tâi-gí gián-kiù lâi kóng sī tsin ū-kè ta̍t ê tsu-liāu。 nā-beh thê-kiong hōo-lâng tsuè gián-kiù， tshiánn sian san-tî bín-kám ê luē-iông。 kì-lio̍k kong-lîng mā ē-sái kuainn--khí-lâi， m̄-koh āu tsi̍t sû ī-tshik huē khah bô tsún。"
          }
        }
      }
    },
    "i18n_dictionary_associationRecordingEnabled": {
      "comment": "Toggle label: enable recording of word-association (bigram) data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
