    "i18n_settings_tpsOrMapsToERInfo": {
      "comment": "Help text for the or→ㄜ toggle (multi-paragraph).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls how TPS candidates display 'or'. When on, 'or' appears as ㄜ; when off, it appears as ㄛ. This setting does not affect search results."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "方音符号の候補で「or」をどう表示するかを設定します。オンでは ㄜ、オフでは ㄛ と表示します。検索結果には影響しません。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "控制方音符號候選詞按怎顯示 or。開啟時顯示做 ㄜ，關閉時顯示做 ㄛ。這个設定袂影響揣詞結果。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "khòng-chè hong-im-hû-hō hāu-soán sû án-nóa hián-sī or. phah-khui sî hián-sī chò ㄜ, koaiⁿ--khí-lâi sî hián-sī chò ㄛ. chit ê siat-tēng bōe éng-hióng chhōe sû kiat-kó."
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "khòng-tsè hong-im-hû-hō hāu-suán sû án-nuá hián-sī or. phah-khui sî hián-sī tsò ㄜ, kuainn--khí-lâi sî hián-sī tsò ㄛ. tsit ê siat-tīng buē íng-hióng tshuē sû kiat-kó."
          }
        }
      }
    },
