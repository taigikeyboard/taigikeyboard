    "i18n_dictionary_sttiDescription": {
      "comment": "MOE academic-terminology (STTI) dictionary — toggle description in dictionary settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Since 2017, the project has translated academic terminology from eight fields into Taigi: language arts, mathematics, social studies, natural science, arts, integrative activities, technology, and health and physical education."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2017年から、国語・数学・社会・自然科学・芸術・総合的活動・科学技術・保健体育の8領域の学科用語を台湾語に翻訳しています。"
          }
        }
      }
    },
