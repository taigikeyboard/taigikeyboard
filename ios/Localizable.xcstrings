      "comment": "Title of the add-custom-entry dialog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Word"
          }
        },
        "ja": {
          "stringUnit": {
