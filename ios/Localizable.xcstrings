    "i18n_home_setupGuideCompletedMessage": {
      "comment": "Setup-guide full-screen closing paragraph: restart the app and switch via the globe key.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once done, restart the app you are using so it reloads the keyboard list. Then, wherever you can type, press and hold the globe icon to switch to Taigi Keyboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了したら、使用中のアプリを再起動してキーボード一覧を読み込み直してください。その後、文字を入力できる場所で地球儀アイコンを長押しして、台湾語キーボードに切り替えます。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "完成了後，重開你目前使用 ê App，予 App 重掠新 ê 齒盤清單。紲落來，佇會當拍字 ê 所在，揤牢地球圖示切去台語齒盤"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "oân-sêng liáu-āu， têng-khui lí ba̍k-chêng sú-iōng ê App， hō͘ App tāng lia̍h sin ê khí-pôaⁿ chheng-toaⁿ。 sòa--lo̍h-lâi， tī ē-tàng phah-jī ê só͘-chāi， chhi̍h tiâu tōe-kiû-tô͘ sī chhiat khì tâi-gí khí-pôaⁿ"
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "uân-sîng liáu-āu， tîng-khui lí ba̍k-tsîng sú-iōng ê App， hōo App tāng lia̍h sin ê khí-puânn tshing-tuann。 suà--lo̍h-lâi， tī ē-tàng phah-jī ê sóo-tsāi， tshi̍h tiâu tuē-kiû-tôo sī tshiat khì tâi-gí khí-puânn"
          }
        }
      }
    },
    "i18n_home_setupGuideDescription": {
      "comment": "Setup-guide intro paragraph: third-party keyboards must be enabled manually.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone requires third-party keyboards to be enabled manually. Follow the steps below to finish setup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンの仕様上、サードパーティ製キーボードは手動で有効にする必要があります。下記の手順に従って設定を完了してください。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "手機仔系統規定第三方齒盤愛手動啟用才會當使用，請照下跤 ê 說明完成設定。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "chhiú-ki-á hē-thóng kui-tēng tē-saⁿ hong khí-pôaⁿ ài chhiú-tōng khé-iōng chiah ē tng sú-iōng， chhiáⁿ chiàu ē-kha ê soat-bêng oân-sêng siat-tēng。"
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "tshiú-ki-á hē-thóng kui-tīng tē-sann hong khí-puânn ài tshiú-tōng khé-iōng tsiah ē tng sú-iōng， tshiánn tsiàu ē-kha ê suat-bîng uân-sîng siat-tīng。"
          }
        }
      }
    },
