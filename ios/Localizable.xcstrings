        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Tâi-huâ suànn-tíng sû-tián\" sī Tīng Liông-uí kàu-siū thê-kiong tsu-liāu, Iûnn Ín-giân kàu-siū pian-siu."
          }
        }
      }
