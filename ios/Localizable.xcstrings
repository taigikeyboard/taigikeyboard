    },
    "i18n_common_taiwanJapanDict": {
      "comment": "Display name of the Taiwanese-Japanese Grand Dictionary (Taigi translation) data source.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taiwanese-Japanese Dictionary (Taigi Edition)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台日大辞典 台湾語訳"
          }
        }
      }
    },
    "i18n_common_taiwanPlantDict": {
      "comment": "Display name of the Taiwan plant-name glossary data source.",
      "extractionState": "manual",
      "localizations": {
