    "i18n_dictionary_associationDescription": {
      "comment": "Description of the word-association CSV format (5-column layout).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Association records use a plain-text CSV file with 5 columns: previous word, previous romanization, next word, next romanization, count. No header row."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語連携の記録は 5 列のプレーンテキスト CSV ファイルを使用します：前の単語、前のローマ字、次の単語、次のローマ字、回数。ヘッダー行は不要です。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "詞關聯紀錄使用 CSV 純文字檔案，共 5 欄：頭前詞、頭前拍字、後壁詞、後壁拍字、次數，毋免囥標題。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "sû koan-liân kì-lio̍k sú-iōng CSV sûn bûn-jī tòng-àn, kā 5 nôa: thâu-chêng sû, thâu-chêng phah-jī, āu-piah sû, āu-piah phah-jī, chhù siàu, m̄-bián khǹg piau-tôe."
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "sû kuan-liân kì-lio̍k sú-iōng CSV sûn bûn-jī tòng-àn, kā 5 nuâ: thâu-tsîng sû, thâu-tsîng phah-jī, āu-piah sû, āu-piah phah-jī, tshù siàu, m̄-bián khǹg piau-tuê."
          }
        }
      }
    },
    "i18n_dictionary_associationExportCSV": {
