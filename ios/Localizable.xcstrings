      }
    },
    "i18n_dictionary_customDictEnabledInfo": {
      "comment": "Info-dialog body explaining what enabling the custom dictionary does.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, words you add appear among the candidates. When off, your custom words no longer show up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、追加した単語が候補に表示されます。オフにすると、カスタム単語は表示されなくなります。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "拍開了後，家己加入 ê 詞會出現佇候選詞內底。關起來了後，自訂詞就袂閣出現。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "phah-khui liáu-āu， ka-kī ka-ji̍p ê sû hōe chhut-hiān tī hāu-soán sû lāi-té。 koaiⁿ--khí-lâi liáu-āu， chū tēng sû chiū bōe koh chhut-hiān。"
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "phah-khui liáu-āu， ka-kī ka-ji̍p ê sû huē tshut-hiān tī hāu-suán sû lāi-té。 kuainn--khí-lâi liáu-āu， tsū tīng sû tsiū buē koh tshut-hiān。"
          }
        }
      }
    },
    "i18n_dictionary_customDictPrivacyWarning": {
      "comment": "Privacy warning against storing sensitive personal data in the custom dictionary.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please do not store sensitive personal data in the custom dictionary, such as ID numbers, account passwords, or credit-card numbers. Mind your information security."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人情報保護のため、カスタム辞書には機密性の高い個人データ（身分証番号、口座のパスワード、クレジットカード番号など）を保存しないでください。情報セキュリティにご注意ください。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請毋通佇自訂詞庫囥敏感 ê 個人資料，親像身分證字號、口座密碼、信用卡號碼，請注意家己 ê 資訊安全。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "chhiáⁿ m̄-thang tī chū tēng sû khò͘ khǹg bín-kám ê kò-jîn-chu-liāu， chhin-chhiūⁿ sin-hūn-chèng jī-hō、 kháu-chō bi̍t-bé、 sìn-iōng-khah hō-bé， chhiáⁿ chù-ì ka-kī ê chu-sìn an-choân。"
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "tshiánn m̄-thang tī tsū tīng sû khòo khǹg bín-kám ê kò-jîn-tsu-liāu， tshin-tshiūnn sin-hūn-tsìng jī-hō、 kháu-tsō bi̍t-bé、 sìn-iōng-khah hō-bé， tshiánn tsù-ì ka-kī ê tsu-sìn an-tsuân。"
          }
        }
      }
    },
