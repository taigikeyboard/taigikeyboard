      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search Taiwanese Taigi and Mandarin, with audio for headwords and example sentences for easy learning. Includes category and radical-stroke indexes plus appendices."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台湾語と中国語で検索でき、見出し語と例文の発音を聞いて学習できます。分類索引・部首画数索引・付録付き。"
          }
        }
      }
    },
    "i18n_dictionary_moeSectionTitle": {
      "comment": "Section header grouping MOE dictionary sources.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOE Characters"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "教育部の用字"
          }
        }
      }
    },
    "i18n_dictionary_newwordDescription": {
      "comment": "Taigi TV new-words dictionary — toggle description in dictionary settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taigi TV invites experts and scholars to meet regularly, settle fitting Taigi terms for emerging words, and build a public lookup glossary."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台語テレビ局が専門家・学者を招き、定期的に会議を開いて新語の適切な台湾語表現を検討し、一般向けの検索辞書を構築しています。"
          }
        }
      }
    },
