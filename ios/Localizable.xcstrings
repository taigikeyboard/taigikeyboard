    "i18n_home_setupInfoMessage": {
      "comment": "Setup-guide note explaining what 'Allow Full Access' means and the privacy stance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Allow Full Access\" lets the keyboard recognize your key presses and turn them into the text you type. Rest assured, the app does not record your data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「フルアクセスを許可」とは、キーボードがあなたのキー操作を認識し、入力した文字に変換できるようにすることです。ご安心ください。本アプリがあなたのデータを記録することはありません。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「允准完整取用」意思是予齒盤會當捌你揤 ê 動作，成做你拍 ê 字。請放心，App 袂紀錄你 ê 資料。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "「ún-chún oân-chéng chhú-iōng」 ì-sù sī hō͘ khí-pôaⁿ ē-tàng bat lí chhi̍h ê tōng-chok， chiâⁿ-chòe lí phah ê jī。 chhiáⁿ hòng-sim，App bōe kì-lio̍k lí ê chu-liāu。"
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "「ún-tsún uân-tsíng tshú-iōng」 ì-sù sī hōo khí-puânn ē-tàng bat lí tshi̍h ê tōng-tsok， tsiânn-tsuè lí phah ê jī。 tshiánn hòng-sim，App buē kì-lio̍k lí ê tsu-liāu。"
          }
        }
      }
    },
    "i18n_home_setupKeyboard": {
