    "i18n_home_setupInfoMessage": {
      "comment": "Setup-guide note explaining that 'Allow Full Access' permits app/keyboard data sharing and stating the network privacy policy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Allow Full Access\" lets the keyboard share settings and usage data with the app. Taigi Keyboard does not send what you type over the network."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「フルアクセスを許可」すると、キーボードとアプリで設定や利用データを共有できます。台語キーボードは入力内容をネットワークへ送信しません。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「允准完整取用」予齒盤會當佮 App 共用設定佮使用資料。台語齒盤袂共你拍 ê 內容送去網路。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ún-chún oân-chéng chhú-iōng\" hō͘ khí-pôaⁿ ē-tàng kah App kiōng-iōng siat-tēng kah sú-iōng chu-liāu. tâi-gí khí-pôaⁿ bōe kā lí phah ê lōe-iông sàng khì bāng-lō͘."
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ún-tsún uân-tsíng tshú-iōng\" hōo khí-puânn ē-tàng kah App kiōng-iōng siat-tīng kah sú-iōng tsu-liāu. tâi-gí khí-puânn buē kā lí phah ê luē-iông sàng khì bāng-lōo."
          }
        }
      }
    },
    "i18n_home_setupKeyboard": {
      "comment": "Home section header above the keyboard-activation guide row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
