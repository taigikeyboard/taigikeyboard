    "i18n_dictionary_associationRecordingEnabledInfo": {
      "comment": "Info-dialog body explaining what association recording does for next-word prediction.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the keyboard records which words follow which, making continuous suggestions more accurate over time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、どの単語の後にどの単語が続くかをキーボードが記録し、連続入力の予測が次第に正確になります。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "拍開了後，齒盤會記錄頭前、後壁 ê 關聯詞，予連紲建議愈來愈準。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "phah-khui liáu-āu， khí-pôaⁿ hōe kì-lio̍k thâu-chêng、 āu-piah ê koan-liân sû， hō͘ liân-sòa kiàn-gī jú-lâi-jú chún。"
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "phah-khui liáu-āu， khí-puânn huē kì-lio̍k thâu-tsîng、 āu-piah ê kuan-liân sû， hōo liân-suà kiàn-gī jú-lâi-jú tsún。"
          }
        }
      }
    },
    "i18n_dictionary_backupPrivacyWarning": {
      "comment": "Privacy note that backup files contain all usage records and are cross-platform.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup files contain all your usage records and work on both iOS and Android, so you need not worry when switching phones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップファイルにはすべての利用記録が含まれ、iOS と Android の両方で使用できます。機種変更の際もご安心ください。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "備份檔案內底包含你所有 ê 使用紀錄，佇 iOS 佮 Android 攏通用，準講換機仔嘛毋免煩惱。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "pī-hūn tòng-àn lāi-té pau-hâm lí só͘-iú ê sú-iōng kì-lio̍k， tī iOS kah Android láng thong-iōng， chún-kóng ōaⁿ ki-á mā m̄-bián hoân-ló。"
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "pī-hūn tòng-àn lāi-té pau-hâm lí sóo-iú ê sú-iōng kì-lio̍k， tī iOS kah Android láng thong-iōng， tsún-kóng uānn ki-á mā m̄-bián huân-ló。"
          }
        }
      }
    },
