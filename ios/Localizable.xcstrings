      "comment": "Destructive action: delete all custom-dictionary entries.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete All Custom Words"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのカスタム単語を削除"
          }
        }
      }
    },
    "i18n_dictionary_deleteAllMessage": {
      "comment": "Confirmation dialog body for deleting all custom-dictionary entries.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all custom words?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのカスタム単語を削除しますか？"
          }
        }
      }
    },
    "i18n_dictionary_devDescription": {
      "comment": "Developer supplement dictionary — toggle description in dictionary settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds government agencies, common names, administrative divisions, dates, times, numbers, and other words with limited coverage in the MOE Dictionary."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "政府機関、一般的な人名、行政区、日付、時刻、数字など、教育部辞典で収録の少ない語を補います。"
          }
        }
      }
    },
    "i18n_dictionary_devSupplementDict": {
      "comment": "Display name of the developer supplement dictionary file.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supplementary Word List"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "補足単語リスト"
          }
        }
      }
    },
    "i18n_dictionary_editEntry": {
      "comment": "Title of the edit-custom-entry dialog.",
      "extractionState": "manual",
