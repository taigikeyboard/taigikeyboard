    "i18n_home_setupInfoMessage": {
      "comment": "Setup-guide note explaining what 'Allow Full Access' means and the privacy stance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Allow Full Access\" lets the keyboard recognize your key presses and turn them into the text you type. Rest assured, the app does not record your data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「フルアクセスを許可」とは、キーボードがあなたのキー操作を認識し、入力した文字に変換できるようにすることです。ご安心ください。本アプリがあなたのデータを記録することはありません。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「允准完整取用」意思是予齒盤會當捌你揤 ê 動作，成做你拍 ê 字。請放心，App 袂紀錄你 ê 資料。"
          }
        }
      }
    },
