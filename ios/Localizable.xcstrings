    "i18n_dictionary_frequencyDescription": {
      "comment": "Description of the word-frequency CSV format (column layout).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequency records use a CSV text file with 3 columns: Hanji, Tâi-lô, and count. No header row. The legacy 2-column format, Hanji and count, is also accepted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語頻度の記録は、漢字・台羅・回数の 3 列からなる CSV テキストファイルを使用します。ヘッダー行は不要です。旧形式の「漢字・回数」の 2 列もインポートできます。"
          }
        }
      }
    },
