    "i18n_dictionary_customDictEnabledInfo": {
      "comment": "Info-dialog body explaining what enabling the custom dictionary does.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, words you add appear among the candidates. When off, your custom words no longer show up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、追加した単語が候補に表示されます。オフにすると、カスタム単語は表示されなくなります。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "拍開了後，自訂詞會出現佇候選詞內底；關起來了後，就袂閣出現。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "phah-khui liáu-āu, chū-tēng-sû ē chhut-hiān tī hāu-soán sû lāi-té; koaiⁿ--khí-lâi liáu-āu, chiū bōe koh chhut-hiān."
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "phah-khui liáu-āu, tsū-tīng-sû ē tshut-hiān tī hāu-suán sû lāi-té; kuainn--khí-lâi liáu-āu, tsiū buē koh tshut-hiān."
          }
        }
      }
    },
    "i18n_dictionary_customDictPrivacyWarning": {
      "comment": "Privacy warning against storing sensitive personal data in the custom dictionary.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not store ID numbers, passwords, credit-card numbers, or other sensitive data in the custom dictionary."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム辞書には、身分証番号、パスワード、クレジットカード番号などの機密情報を保存しないでください。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂詞庫毋通囥身分證字號、密碼、信用卡號碼抑是其他敏感資料。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "chū-tēng-sû-khò͘ m̄-thang khǹg sin-hūn-chèng jī-hō, bi̍t-bé, sìn-iōng-khah hō-bé ah-sī kî-thaⁿ bín-kám chu-liāu."
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "tsū-tīng-sû-khòo m̄-thang khǹg sin-hūn-tsìng jī-hō, bi̍t-bé, sìn-iōng-khah hō-bé ah-sī kî-thann bín-kám tsu-liāu."
          }
        }
      }
    },
