    "i18n_theme_capReachedMessage": {
      "comment": "Body of the custom-theme cap-reached alert (cap is UserThemeStore.MAX_USER_THEMES = 5).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The custom-theme limit is 5. Delete one before adding another."
          }
