    "i18n_dictionary_filterHint": {
      "comment": "Hint explaining the 100-item display cap and pointing to the search field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list shows the first 100 records. Use the \"Type to search\" field below to find other records."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一覧には先頭の 100 件だけを表示します。ほかの記録は、下の「入力して検索」で検索してください。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "清單干焦顯示頭 100 項。欲揣其他紀錄，請用下跤 ê「拍字揣詞」。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "chheng-toaⁿ kan-ta hián-sī thâu 100 hāng. beh chhōe kî-thaⁿ kì-lio̍k, chhiáⁿ iōng ē-kha ê \"phah-jī chhōe sû\"."
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "tshing-tuann kan-ta hián-sī thâu 100 hāng. beh tshuē kî-thann kì-lio̍k, tshiánn iōng ē-kha ê \"phah-jī tshuē sû\"."
          }
        }
      }
    },
    "i18n_dictionary_frequencyDescription": {
      "comment": "Description of the word-frequency CSV format (column layout).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequency records use a CSV text file with 3 columns: Hanji, Tâi-lô, and count. No header row. The legacy 2-column format, Hanji and count, is also accepted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語頻度の記録は、漢字・台羅・回数の 3 列からなる CSV テキストファイルを使用します。ヘッダー行は不要です。旧形式の「漢字・回数」の 2 列もインポートできます。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "詞頻紀錄使用 CSV 純文字檔案，共 3 欄：漢字、台羅、次數，毋免囥標題。舊版的「漢字、次數」2 欄格式嘛會當匯入。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "sû pîn kì-lio̍k sú-iōng CSV sûn bûn-jī tòng-àn, kā 3 lân: hàn-jī, tâi-lô, chhù-siàu, m̄-bián khǹg piau-tê. kū-pán ê \"hàn-jī, chhù-siàu\" 2 lân keh-sek mā ē-tàng hōe-ji̍p."
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "sû pîn kì-lio̍k sú-iōng CSV sûn bûn-jī tòng-àn, kā 3 lân: hàn-jī, tâi-lô, tshù-siàu, m̄-bián khǹg piau-tê. kū-pán ê \"hàn-jī, tshù-siàu\" 2 lân keh-sik mā ē-tàng huē-ji̍p."
          }
        }
      }
    },
