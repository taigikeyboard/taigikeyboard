    "i18n_dictionary_frequencyPrivacyWarning": {
      "comment": "Privacy warning about sharing word-frequency data for research.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequency records are valuable data for Taiwanese-language research. If you share them for research or model training, please delete sensitive private data first. You can also turn recording off, though candidate ranking will then be less accurate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語頻度の記録は台湾語研究にとって貴重なデータです。研究やモデル学習のために提供する場合は、機密性の高い個人データを先に削除してください。記録機能はオフにもできますが、その場合は候補の並び替えの精度が下がります。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "詞頻紀錄對台語研究來講是真有價值 ê 資料。若欲提供予人研究訓練模型，請先刪除敏感 ê 私人資料。紀錄功能嘛會使關起來，毋過按呢候選詞 ê 排序就會較無準。"
          }
        }
      }
    },
    "i18n_dictionary_frequencyRecordingEnabled": {
      "comment": "Toggle label: enable recording of word-selection frequency.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record Word Frequency"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語頻度を記録"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟詞頻紀錄"
          }
        }
      }
    },
    "i18n_dictionary_frequencyRecordingEnabledInfo": {
      "comment": "Info-dialog body explaining what frequency recording does for candidate ranking.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the keyboard records how often you pick each word and uses it to rank candidates. Words you choose often move toward the front, so the candidates get more accurate over time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、各単語を選んだ回数をキーボードが記録し、候補の並び替えに利用します。よく選ぶ単語が前に移動し、候補が次第に正確になります。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "拍開了後，齒盤會記錄你揀過 ê 詞幾擺，予候選詞排序做參考，定定揀 ê 詞就會排較頭前，按呢候選詞就會愈來愈準。"
          }
        }
      }
    },
