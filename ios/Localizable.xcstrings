            "state": "translated",
            "value": "Taiwan Plant Name Glossary"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台湾植物名彙"
          }
        }
      }
    },
    "i18n_common_viewWebsite": {
      "comment": "Link button opening an official website in the browser (data sources + the app's own site).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Official Website"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式サイト"
          }
        }
      }
    },
    "i18n_dictionary_addEntry": {
      "comment": "Title of the add-custom-entry dialog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Word"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語を追加"
          }
        }
      }
    },
    "i18n_dictionary_associationDescription": {
      "comment": "Description of the word-association CSV format (5-column layout).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Association records use a plain-text CSV file with 5 columns: previous word, previous romanization, next word, next romanization, count. No header row."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語連携の記録は 5 列のプレーンテキスト CSV ファイルを使用します：前の単語、前のローマ字、次の単語、次のローマ字、回数。ヘッダー行は不要です。"
          }
        }
      }
    },
    "i18n_dictionary_associationExportCSV": {
      "comment": "Button: export the word-association records to a CSV file.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Association Records"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語連携の記録をエクスポート"
          }
        }
      }
    },
    "i18n_dictionary_associationImportCSV": {
      "comment": "Button: import word-association records from a CSV file.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import Association Records"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語連携の記録をインポート"
          }
        }
      }
    },
    "i18n_dictionary_associationManagement": {
      "comment": "Page/section title for word-association record management.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Association Records"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語連携の記録"
          }
        }
      }
    },
    "i18n_dictionary_associationPrivacyWarning": {
      "comment": "Privacy warning about sharing word-association data for research.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Association records may reflect phrases you have typed. Check for sensitive content before exporting or sharing them. When recording is off, the keyboard stops learning your next-word habits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語連携の記録には、入力した語句が反映される場合があります。エクスポートや共有の前に、機密情報が含まれていないか確認してください。記録をオフにすると、次の単語の使い方を学習しなくなります。"
          }
        }
      }
    },
    "i18n_dictionary_associationRecordingEnabled": {
      "comment": "Toggle label: enable recording of word-association (bigram) data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record Word Associations"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語連携を記録"
          }
        }
      }
    },
    "i18n_dictionary_associationRecordingEnabledInfo": {
      "comment": "Info-dialog body explaining what association recording does for next-word prediction.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the keyboard records which words follow each other to improve next-word suggestions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、単語の前後関係を記録し、次の単語の候補に利用します。"
          }
        }
      }
    },
    "i18n_dictionary_backupPrivacyWarning": {
      "comment": "Privacy note that backup files contain all usage records and are cross-platform.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup contains your custom words, frequency records, and association records. You can import it on iOS or Android. Store the file securely because it may contain private content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップには、カスタム単語、単語頻度、単語連携の記録が含まれます。iOS と Android のどちらでもインポートできます。個人的な内容が含まれる場合があるため、安全に保管してください。"
          }
        }
      }
    },
    "i18n_dictionary_backupRestore": {
      "comment": "Section title for full backup/restore of all user data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup and Restore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップと復元"
          }
        }
      }
    },
    "i18n_dictionary_clear": {
      "comment": "Generic clear button label (e.g. confirm clearing all frequency/association records).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリア"
          }
        }
      }
    },
    "i18n_dictionary_clearAllAssociation": {
      "comment": "Destructive action: delete all word-association records.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete All Association Records"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての単語連携の記録を削除"
          }
        }
      }
    },
    "i18n_dictionary_clearAllFrequency": {
      "comment": "Destructive action: delete all word-frequency records.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete All Frequency Records"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての単語頻度の記録を削除"
          }
        }
      }
    },
    "i18n_dictionary_clearAssociationMessage": {
      "comment": "Confirmation dialog body for deleting all word-association records.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all association records?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての単語連携の記録を削除しますか？"
          }
        }
      }
    },
    "i18n_dictionary_clearFrequencyMessage": {
      "comment": "Confirmation dialog body for deleting all word-frequency records.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all frequency records?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての単語頻度の記録を削除しますか？"
          }
        }
      }
    },
    "i18n_dictionary_customDictDescription": {
      "comment": "Description of the custom-dictionary CSV format (column layout).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The custom dictionary uses a plain-text CSV file: column 1 holds the romanization to type, column 2 holds the Hanji. No header row."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム辞書はプレーンテキストの CSV ファイルを使用します。1 列目に入力するローマ字、2 列目に漢字を記入します。ヘッダー行は不要です。"
          }
        }
      }
    },
    "i18n_dictionary_customDictEmpty": {
      "comment": "Empty-state hint shown when the custom dictionary has no entries. On macOS it is the symbol's accessibility label rather than visible copy; the wording holds there because the pane has a + button too.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + to add a custom word"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ をタップしてカスタム単語を追加"
          }
        }
      }
    },
    "i18n_dictionary_customDictEnabled": {
      "comment": "Toggle label: enable the user's custom dictionary in candidate suggestions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Custom Dictionary"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム辞書を有効にする"
          }
        }
      }
    },
    "i18n_dictionary_customDictEnabledInfo": {
      "comment": "Info-dialog body explaining what enabling the custom dictionary does.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, words you add appear among the candidates. When off, your custom words no longer show up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、追加した単語が候補に表示されます。オフにすると、カスタム単語は表示されなくなります。"
          }
        }
      }
    },
    "i18n_dictionary_customDictPrivacyWarning": {
      "comment": "Privacy warning against storing sensitive personal data in the custom dictionary.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not store ID numbers, passwords, credit-card numbers, or other sensitive data in the custom dictionary."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム辞書には、身分証番号、パスワード、クレジットカード番号などの機密情報を保存しないでください。"
          }
        }
      }
    },
    "i18n_dictionary_customDictionary": {
      "comment": "Custom dictionary section/page title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom Dictionary"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム辞書"
          }
        }
      }
    },
    "i18n_dictionary_dataManagement": {
      "comment": "Section title for keyboard-data management (custom words, frequency/association records, backup/import/export).",
      "extractionState": "manual",
      "localizations": {
