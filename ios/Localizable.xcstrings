          }
        }
      }
    },
    "i18n_dictionary_frequencyDescription": {
      "comment": "Description of the word-frequency CSV format (column layout).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequency records use a plain-text CSV file: column 1 holds the word, column 2 holds the count. No header row."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語頻度の記録はプレーンテキストの CSV ファイルを使用します。1 列目に単語、2 列目に回数を記入します。ヘッダー行は不要です。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "詞頻紀錄使用 CSV 純文字檔案，第 1 欄囥詞，第 2 欄囥次數，毋免囥標題。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "sû pîn kì-lio̍k sú-iōng CSV sûn bûn-jī-tòng àn， tē 1 nôa khǹg sû， tē 2 nôa khǹg chhù siàu， m̄-bián khǹg piau-tôe。"
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "sû pîn kì-lio̍k sú-iōng CSV sûn bûn-jī-tòng àn， tē 1 nuâ khǹg sû， tē 2 nuâ khǹg tshù siàu， m̄-bián khǹg piau-tuê。"
          }
        }
      }
    },
