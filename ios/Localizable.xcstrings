        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台語キーボードは今後も無料で、有料機能を設けません。台湾語を学びたい、書きたい人が費用を気にせず使えることを願っています。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "台語齒盤會一直免費，嘛袂設付費功能。我向望想欲學台語、寫台語 ê 人攏會當無負擔使用。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "tâi-gí khí-pôaⁿ ē it-ti̍t bián-hùi, mā bōe siat hù-hùi kong-lêng. góa ǹg-bāng siūⁿ-beh ha̍k tâi-gí, siá tâi-gí ê lâng lóng ē-tàng bô hū-tam sú-iōng."
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "tâi-gí khí-puânn ē it-ti̍t bián-huì, mā buē siat hù-huì kong-lîng. guá ǹg-bāng siūnn-beh ha̍k tâi-gí, siá tâi-gí ê lâng lóng ē-tàng bô hū-tam sú-iōng."
          }
        }
      }
    },
