        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "khí-pôaⁿ ài phah-khui chiah ē-tàng sú-iōng"
          }
        },
        "nan-Latn-TW-x-tailo": {
