    "i18n_dictionary_frequencyPrivacyWarning": {
      "comment": "Privacy warning about sharing word-frequency data for research.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequency records are valuable data for Taiwanese-language research. If you share them for research or model training, please delete sensitive private data first. You can also turn recording off, though candidate ranking will then be less accurate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語頻度の記録は台湾語研究にとって貴重なデータです。研究やモデル学習のために提供する場合は、機密性の高い個人データを先に削除してください。記録機能はオフにもできますが、その場合は候補の並び替えの精度が下がります。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "詞頻紀錄對台語研究來講是真有價值 ê 資料。若欲提供予人研究訓練模型，請先刪除敏感 ê 私人資料。紀錄功能嘛會使關起來，毋過按呢候選詞 ê 排序就會較無準。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "sû pîn kì-lio̍k tùi tâi-gí gián-kiù lâi kóng sī chin ū-kè ta̍t ê chu-liāu。 nā-beh thê-kiong hō͘-lâng gián-kiù hùn-liān bô͘-hêng， chhiáⁿ sian san-tî bín-kám ê su-jîn chu-liāu。 kì-lio̍k kong-lêng mā ē-sái koaiⁿ--khí-lâi， m̄-koh án-ne hāu-soán sû ê pâi-sī chiū hōe khah bô chún。"
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "sû pîn kì-lio̍k tuì tâi-gí gián-kiù lâi kóng sī tsin ū-kè ta̍t ê tsu-liāu。 nā-beh thê-kiong hōo-lâng gián-kiù hùn-liān bôo-hîng， tshiánn sian san-tî bín-kám ê su-jîn tsu-liāu。 kì-lio̍k kong-lîng mā ē-sái kuainn--khí-lâi， m̄-koh án-ne hāu-suán sû ê pâi-sī tsiū huē khah bô tsún。"
          }
        }
      }
    },
    "i18n_dictionary_frequencyRecordingEnabled": {
      "comment": "Toggle label: enable recording of word-selection frequency.",
      "extractionState": "manual",
