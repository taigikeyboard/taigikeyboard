    "i18n_home_taiHuaCopyright": {
      "comment": "Copyright attribution for the online Taigi-Mandarin cross-reference dictionary.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "© Tēⁿ Liông-uí"
          }
        },
