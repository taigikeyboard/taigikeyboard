          }
        }
      }
    },
    "i18n_dictionary_associationManagement": {
      "comment": "Page/section title for word-association record management.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Association Records"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
