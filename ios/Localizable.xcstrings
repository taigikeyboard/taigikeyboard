    "i18n_home_setupBrandWarning": {
      "comment": "Setup-guide note: steps may differ slightly across phone brands.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps may differ slightly between phone brands, but the overall process is much the same."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンのメーカーによって設定方法が少し異なる場合がありますが、大まかな流れはほぼ同じです。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無仝牌子 ê 手機仔，設定 ê 方式可能會淡薄仔無仝款，毋過方式應該攏差不多。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "bô kâng pâi-chú ê chhiú-ki-á， siat-tēng ê hong-sek khó-lêng hōe tām-po̍h-á bô-kāng-khoán， m̄-koh hong-sek èng-kai láng chha-put-to。"
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "bô kâng pâi-tsú ê tshiú-ki-á， siat-tīng ê hong-sik khó-lîng huē tām-po̍h-á bô-kāng-khuán， m̄-koh hong-sik ìng-kai láng tsha-put-to。"
          }
        }
      }
    },
