    "i18n_home_setupGuideStep2AddKeyboard": {
      "comment": "Setup-guide step 2 title: tap 'Add keyboard' and 'Allow Full Access'.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap \"Add keyboard\" and \"Allow Full Access\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キーボードを追加」「フルアクセスを許可」をタップ"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "點揤「增加齒盤」、「允准完整取用」"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "tiám-chhi̍h「cheng-ka khí-pôaⁿ」、「ún-chún oân-chéng chhú-iōng」"
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "tiám-tshi̍h「tsing-ka khí-puânn」、「ún-tsún uân-tsíng tshú-iōng」"
          }
        }
      }
