          }
        }
      }
    },
    "i18n_dictionary_associationPrivacyWarning": {
      "comment": "Privacy warning about sharing word-association data for research.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Association records are valuable data for Taiwanese-language research. If you share them for research, please delete sensitive content first. You can also turn recording off, though next-word prediction will then be less accurate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語連携の記録は台湾語研究にとって貴重なデータです。研究のために提供する場合は、機密性の高い内容を先に削除してください。記録機能はオフにもできますが、その場合は次の単語の予測精度が下がります。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "詞關聯紀錄對台語研究來講是真有價值 ê 資料。若欲提供予人做研究，請先刪除敏感 ê 內容。紀錄功能嘛會使關起來，毋過後一詞預測會較無準。"
          }
        }
      }
    },
    "i18n_dictionary_associationRecordingEnabled": {
      "comment": "Toggle label: enable recording of word-association (bigram) data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record Word Associations"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語連携を記録"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟詞關聯紀錄"
          }
        }
      }
    },
    "i18n_dictionary_associationRecordingEnabledInfo": {
      "comment": "Info-dialog body explaining what association recording does for next-word prediction.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the keyboard records which words follow which, making continuous suggestions more accurate over time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、どの単語の後にどの単語が続くかをキーボードが記録し、連続入力の予測が次第に正確になります。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "拍開了後，齒盤會記錄頭前、後壁 ê 關聯詞，予連紲建議愈來愈準。"
          }
        }
      }
    },
    "i18n_dictionary_backupPrivacyWarning": {
      "comment": "Privacy note that backup files contain all usage records and are cross-platform.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup files contain all your usage records and work on both iOS and Android, so you need not worry when switching phones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップファイルにはすべての利用記録が含まれ、iOS と Android の両方で使用できます。機種変更の際もご安心ください。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "備份檔案內底包含你所有 ê 使用紀錄，佇 iOS 佮 Android 攏通用，準講換機仔嘛毋免煩惱。"
          }
        }
      }
    },
    "i18n_dictionary_backupRestore": {
      "comment": "Section title for full backup/restore of all user data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup and Restore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
