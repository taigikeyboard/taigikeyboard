    "i18n_home_setupGuideCompletedMessage": {
      "comment": "Setup-guide full-screen closing paragraph: restart the app and switch via the globe key.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once done, restart the app you are using so it reloads the keyboard list. Then, wherever you can type, press and hold the globe icon to switch to Taigi Keyboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了したら、使用中のアプリを再起動してキーボード一覧を読み込み直してください。その後、文字を入力できる場所で地球儀アイコンを長押しして、台湾語キーボードに切り替えます。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "完成了後，重開你目前使用 ê App，予 App 重掠新 ê 齒盤清單。紲落來，佇會當拍字 ê 所在，揤牢地球圖示切去台語齒盤"
          }
        }
      }
    },
    "i18n_home_setupGuideDescription": {
      "comment": "Setup-guide intro paragraph: third-party keyboards must be enabled manually.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone requires third-party keyboards to be enabled manually. Follow the steps below to finish setup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンの仕様上、サードパーティ製キーボードは手動で有効にする必要があります。下記の手順に従って設定を完了してください。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "手機仔系統規定第三方齒盤愛手動啟用才會當使用，請照下跤 ê 說明完成設定。"
          }
        }
      }
    },
