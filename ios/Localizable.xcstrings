    "i18n_home_setupInfoMessage": {
      "comment": "Setup-guide note explaining that 'Allow Full Access' permits app/keyboard data sharing and stating the network privacy policy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Allow Full Access\" lets the keyboard share settings and usage data with the app. Taigi Keyboard does not send what you type over the network."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「フルアクセスを許可」すると、キーボードとアプリで設定や利用データを共有できます。台語キーボードは入力内容をネットワークへ送信しません。"
          }
        }
      }
    },
