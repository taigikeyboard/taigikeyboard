          "stringUnit": {
            "state": "translated",
            "value": "教育部 学術用語 台湾語対訳"
          }
        }
      }
    },
    "i18n_common_taiHuaDict": {
      "comment": "Display name of the online Taigi-Mandarin cross-reference dictionary data source.",
      "extractionState": "manual",
      "localizations": {
