    "i18n_dictionary_frequencyRecordingEnabledInfo": {
      "comment": "Info-dialog body explaining what frequency recording does for candidate ranking.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the keyboard records how often you pick each word and uses it to rank candidates. Words you choose often move toward the front, so the candidates get more accurate over time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、各単語を選んだ回数をキーボードが記録し、候補の並び替えに利用します。よく選ぶ単語が前に移動し、候補が次第に正確になります。"
          }
        },
        "nan-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "拍開了後，齒盤會記錄你揀過 ê 詞幾擺，予候選詞排序做參考，定定揀 ê 詞就會排較頭前，按呢候選詞就會愈來愈準。"
          }
        },
        "nan-Latn-TW-x-poj": {
          "stringUnit": {
            "state": "translated",
            "value": "phah-khui liáu-āu， khí-pôaⁿ hōe kì-lio̍k lí kéng kòe ê sû kúi-pái， hō͘ hāu-soán sû pâi-sī chòe chham-khó， tiāⁿ-tiāⁿ kéng ê sû chiū hōe pâi khah thâu-chêng， án-ne hāu-soán sû chiū hōe jú-lâi-jú chún。"
          }
        },
        "nan-Latn-TW-x-tailo": {
          "stringUnit": {
            "state": "translated",
            "value": "phah-khui liáu-āu， khí-puânn huē kì-lio̍k lí kíng kuè ê sû kuí-pái， hōo hāu-suán sû pâi-sī tsuè tsham-khó， tiānn-tiānn kíng ê sû tsiū huē pâi khah thâu-tsîng， án-ne hāu-suán sû tsiū huē jú-lâi-jú tsún。"
          }
        }
      }
    },
