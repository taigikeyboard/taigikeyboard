        {
          "text": {
            "hanji": "2. 重開你當咧使用 ê App，予 App 重新掠著齒盤。"
          }
        },
        {
          "text": {
            "hanji": "3. 佇會當拍字 ê 所在，揤牢地球圖示就會使切去台語齒盤。"
          }
        }
      ]
