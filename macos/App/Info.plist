<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Bundle metadata for the macOS input method. Values are CONCRETE: there is no
    Xcode project to expand `$(…)` build settings, so a placeholder would ship
    verbatim into the installed bundle.

    `InputMethodServerControllerClass` / `NSPrincipalClass` are resolved by
    InputMethodKit through NSClassFromString. Both types carry an explicit
    `@objc(…)` runtime name so these bare strings stay valid no matter which
    Swift module they end up in.

    `ComponentInputModeDict` is deliberately absent: TL and POJ are an in-app
    setting, not OS-level input modes (docs/architecture/macos-roadmap.md D5).

    Two icons, because the keys answer different questions. `CFBundleIconFile`
    is who this bundle is: the App Store art built from the iOS asset catalogue
    (`ios/…/AppIcon.appiconset`), full colour, shown by Finder and System
    Settings. `tsInputMethodIconFileKey` is what the input source looks like in
    the menu bar, which Apple's own CJK input methods answer with a template
    image rather than an app icon — hence `TISIconIsTemplate`, which tells macOS
    to use only the alpha channel and tint it for the current appearance.
    `scripts/make-menubar-icon.swift` generates that image and documents its
    shape.

    `ATSApplicationFontsPath` activates the typefaces the candidate-window font
    picker offers (`CandidateFontChoice`), from `Contents/Resources/Fonts` that
    `scripts/bundle-app.sh` fills. AppKit registers them process-wide at launch,
    which is why there is no Core Text registration call anywhere in the source;
    remove this key and every font option silently draws in the system font.
-->
<plist version="1.0">
<dict>
	<key>ATSApplicationFontsPath</key>
	<string>Fonts</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- Untranslated fallback, used when the Mac's language matches no `.lproj`
	     the bundle carries. The localized names live in the generated
	     `<lang>.lproj/InfoPlist.strings`, which is what macOS actually shows —
	     see MACOS_BUNDLE_LOCALIZATIONS in tools/i18n/i18n_lib.py. -->
	<key>CFBundleDisplayName</key>
	<string>TaigiKeyboard</string>
	<key>CFBundleExecutable</key>
	<string>TaigiInputMethod</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.siansiansu.inputmethod.TaigiKeyboard</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>TaigiKeyboard</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- The marketing version is kept in lockstep with iOS and Android (one
	     release train, three platforms). The build version is what Installer's
	     BundleIsVersionChecked and pkg-ref compare, so it must strictly increase
	     with every shipped pkg — derived from the marketing version as
	     MAJOR*10000 + MINOR*100 + PATCH, bumped by hand at release time. -->
	<key>CFBundleShortVersionString</key>
	<string>3.6.6</string>
	<key>CFBundleVersion</key>
	<string>30606</string>
	<key>InputMethodConnectionName</key>
	<string>com.siansiansu.inputmethod.TaigiKeyboard_Connection</string>
	<key>InputMethodServerControllerClass</key>
	<string>TaigiInputController</string>
	<!-- Declares that the localized names exist; Apple documents this as a
	     performance hint for displaying them. -->
	<key>LSHasLocalizedDisplayName</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>TaigiInputMethodApplication</string>
	<!-- Caps Lock switches to and from ABC the way Apple's own 新注音 does
	     (USER 2026-08-28). The system implements the switch — short press
	     switches source, long press still latches caps, and it draws its own
	     indicator — so there is no Caps Lock code in this bundle, same as
	     MacishType, McBopomofo, vChewing and MOE's TaiwaneseTaigi. The user
	     turns it on under System Settings › Keyboard › Input Sources › Edit…
	     › "Use Caps Lock to switch to and from ABC".

	     Apple documents the key as switching "between Latin and non-Latin
	     input sources". Declared once before (2026-08-26) it did nothing on a
	     real device, and a `TISGetInputSourceProperty` probe showed why: macOS
	     had registered this input method as
	     `kTISPropertyInputSourceIsASCIICapable = true` — a Latin source, with
	     no ABC to switch to. The repertoire below then listed `Latn` too, and
	     every input method that does switch (MOE's TaiwaneseTaigi, vChewing,
	     McBopomofo) lists Han scripts only, so `Latn` is dropped here although
	     this input method also types romanization: the key is a
	     system-integration classification, not an inventory of output. -->
	<key>TICapsLockLanguageSwitchCapable</key>
	<true/>
	<key>TISIconIsTemplate</key>
	<true/>
	<key>TISInputSourceID</key>
	<string>com.siansiansu.inputmethod.TaigiKeyboard</string>
	<key>TISIntendedLanguage</key>
	<string>mul</string>
	<key>tsInputMethodIconFileKey</key>
	<string>MenuBarIcon.tiff</string>
	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Hant</string>
	</array>
	<!-- The `.taigi` backup document. Declared so the open and save panels in
	     詞庫 → 備份還原 can filter for it; an undeclared extension resolves only
	     to a dynamic type nothing recognises. Same identifier iOS exports
	     (ios/Sources/TaigiKeyboard-Info.plist), because it is the same format.
	     Deliberately NOT paired with CFBundleDocumentTypes: declaring the type
	     says this suite defines the format, while registering a document type
	     would offer an input method to Finder as a way to open files. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>tw.taigikeyboard.backup</string>
			<key>UTTypeDescription</key>
			<string>台語鍵盤備份</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>taigi</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
