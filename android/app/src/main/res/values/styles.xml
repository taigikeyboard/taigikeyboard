<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Smartbar 候選詞樣式 -->
    <style name="SmartbarCandidate">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:background">@drawable/candidate_button_background</item>
        <item name="android:stateListAnimator">@animator/candidate_button_scale</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Smartbar 按鈕基礎樣式 -->
    <style name="SmartbarActionButton">
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:background">@drawable/smartbar_button_background</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Smartbar Icon 按鈕 -->
    <style name="SmartbarActionButton.Icon">
        <item name="android:layout_width">48dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">?smartbar_button_fgColor</item>
    </style>

    <!-- Smartbar Text 按鈕（POJ/TL/En） -->
    <style name="SmartbarActionButton.Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/mode_button_text</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Toolbar icon button: compact weight -->
    <style name="SmartbarToolbarIcon" parent="SmartbarActionButton.Icon">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">0.8</item>
        <item name="android:layout_marginHorizontal">1dp</item>
        <item name="android:padding">4dp</item>
    </style>

    <!-- Toolbar mode button: wider weight for text labels -->
    <style name="SmartbarToolbarMode" parent="SmartbarActionButton.Text">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">2dp</item>
        <item name="android:layout_marginHorizontal">1dp</item>
    </style>

</resources>
