<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 鍵盤 Smartbar 樣式（保留） -->
    <style name="SmartbarCandidate">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:background">@drawable/candidate_button_background</item>
        <item name="android:stateListAnimator">@animator/candidate_button_scale</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="SmartbarContainer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="SmartbarDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">0</item>
        <item name="android:layout_marginTop">@dimen/smartbar_button_margin</item>
        <item name="android:layout_marginBottom">@dimen/smartbar_button_margin</item>
        <item name="android:background">?semiTransparentColor</item>
    </style>

    <!-- Smartbar 按鈕基礎樣式 -->
    <style name="SmartbarActionButton">
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:background">@drawable/smartbar_button_background</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Smartbar Icon 按鈕（Settings） -->
    <style name="SmartbarActionButton.Icon">
        <item name="android:layout_width">48dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">?smartbar_button_fgColor</item>
    </style>

    <!-- Smartbar Text 按鈕（POJ/TL/En） -->
    <style name="SmartbarActionButton.Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/mode_button_text</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 保留舊樣式名稱以相容（指向新樣式） -->
    <style name="SmartbarQuickAction" parent="SmartbarActionButton.Icon" />

    <style name="SmartbarQuickAction.Toggle">
        <item name="android:layout_weight">0</item>
        <item name="android:autoMirrored">true</item>
    </style>

    <style name="SmartbarModeButton" parent="SmartbarActionButton.Text" />

    <!-- Toolbar icon button: compact weight, icons need less width than text -->
    <style name="SmartbarToolbarIcon" parent="SmartbarActionButton.Icon">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">0.8</item>
        <item name="android:layout_marginHorizontal">1dp</item>
        <item name="android:padding">4dp</item>
    </style>

    <!-- Toolbar mode button: wider weight for readable text labels -->
    <style name="SmartbarToolbarMode" parent="SmartbarActionButton.Text">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">2dp</item>
        <item name="android:layout_marginHorizontal">1dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 英文三欄式候選詞樣式 -->
    <style name="SmartbarEnglishCandidate">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/candidate_button_background</item>
        <item name="android:stateListAnimator">@animator/candidate_button_scale</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?smartbar_candidate_fgColor</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- 英文候選詞分隔線樣式 -->
    <style name="SmartbarCandidateDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:background">?semiTransparentColor</item>
    </style>

    <!-- 設定頁卡片樣式（使用 Material 3 主題屬性） -->
    <style name="SettingsCardView" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="contentPadding">8dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="SettingsCardView.Clickable">
        <item name="android:foreground">?selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 分隔線樣式（使用 Material 3 主題屬性） -->
    <style name="ModernDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">28dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <!-- 導航項目樣式（使用 Material 3 主題屬性） -->
    <style name="ModernNavigationItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:background">?selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">68dp</item>
    </style>

    <!-- 標題文字樣式（使用 Material 3 主題屬性） -->
    <style name="ModernTitleText">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

</resources>
