<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 鍵盤專用主題（保持不變） -->
    <style name="KeyboardTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:colorControlNormal">#8A000000</item>
        <item name="android:textColor">#000000</item>
        <item name="semiTransparentColor">#20000000</item>

        <item name="key_bgColor">#FFFFFF</item>
        <item name="key_bgColorPressed">#E0E0E0</item>
        <item name="key_bgColorActive">#BDBDBD</item><!-- Translate button active/swapped state -->
        <item name="key_function_bgColor">#FFFFFF</item>
        <item name="key_function_bgColorPressed">#E0E0E0</item>
        <item name="key_fgColor">?android:textColor</item>
        <item name="key_enter_bgColor">#FFFFFF</item><!-- Same as normal key -->
        <item name="key_enter_bgColorPressed">#E0E0E0</item><!-- Same as normal key pressed -->
        <item name="key_enter_fgColor">#000000</item><!-- Black text on white -->

        <item name="key_popup_bgColor">#EEEEEE</item>
        <item name="key_popup_fgColor">?android:textColor</item>

        <item name="key_popup_extended_bgColor">@android:color/transparent</item>
        <item name="key_popup_extended_bgColorActive">#BDBDBD</item>
        <item name="key_popup_extended_shadowColor">#CDCACACA</item>

        <item name="keyboard_bgColor">#D4D5DD</item>

        <item name="emoji_key_bgColor">?keyboard_bgColor</item>
        <item name="emoji_key_bgColorPressed">?key_popup_extended_bgColorActive</item>
        <item name="emoji_key_fgColor">#757575</item>

        <item name="smartbar_bgColor">?keyboard_bgColor</item>
        <item name="smartbar_fgColor">?android:textColor</item>
        <item name="smartbar_button_bgColor">?key_bgColor</item>
        <item name="smartbar_button_bgColorPressed">?key_bgColorPressed</item>
        <item name="smartbar_button_fgColor">?key_fgColor</item>
        <item name="smartbar_candidate_fgColor">?android:textColor</item>
        <item name="smartbar_accentColor">#007AFF</item><!-- iOS blue, for toolbar selection -->
        <item name="smartbar_candidate_subtitle_fgColor">#6D6D73</item>

        <item name="overlay_button_bgColorPressed">#40000000</item>
    </style>

    <!-- 主 App 設定頁主題 - 使用 Material 3 系統預設 -->
    <style name="SettingsTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 使用 Material 3 DayNight 預設色彩，自動支援深淺模式 -->

        <!-- 系統列設定 -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>


</resources>
