<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource-shrinker keep list (release builds: isShrinkResources = true).

  WHY THIS FILE EXISTS — DO NOT DELETE:
  Feature / FAQ icons and slideshow images are declared by *string name* in
  content/tab1-features.json + content/tab1-faq.json and resolved at runtime
  via Resources.getIdentifier() (see ui/components/DrawableResourceResolver.kt).
  These drawables have ZERO static R.drawable.* references, so the R8 resource
  shrinker cannot prove they are used and strips them from release AABs. The
  symptom: in release the icons fall back to the lightbulb placeholder and
  slideshow images render blank, while debug (no shrinking) looks correct.

  Every drawable in this app is either statically referenced (kept anyway) or
  dynamically resolved by name (cannot be statically proven -> must be kept),
  so keeping the whole drawable type is correct and maintenance-free: adding a
  new content-JSON image will never silently regress release again. Resource
  shrinking still trims unused layout / string / color / anim resources.

  Filename is package-qualified because keep files have global merge scope;
  this avoids collisions if a dependency ever ships its own raw/keep.xml.

  Ref: https://developer.android.com/topic/performance/app-optimization/customize-which-resources-to-keep
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/*" />
