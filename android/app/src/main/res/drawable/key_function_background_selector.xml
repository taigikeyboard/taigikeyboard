<?xml version="1.0" encoding="utf-8"?>
<!-- Function key (shift, backspace, etc.) background selector - uses same colors as character keys -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/key_bgColorPressed" />
            <corners android:radius="@dimen/key_borderRadius" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/key_bgColor" />
            <corners android:radius="@dimen/key_borderRadius" />
        </shape>
    </item>
</selector>
