<?xml version="1.0" encoding="utf-8"?>
<!-- Candidate button background: supports the pressed state, rounded corners -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state: translucent background + rounded corners -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?semiTransparentColor" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Focused state: translucent background + rounded corners -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?semiTransparentColor" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Default state: transparent background + rounded corners -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
