<?xml version="1.0" encoding="utf-8"?>
<com.siansiansu.taigikeyboard.ime.text.smartbar.SmartbarView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/smartbar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/smartbar_height"
    android:background="?smartbar_bgColor">

    <!-- TODO: 暫時停用展開收合功能
    <com.siansiansu.taigikeyboard.ime.text.smartbar.SmartbarQuickActionButton
        android:id="@+id/quick_action_toggle"
        style="@style/SmartbarQuickAction.Toggle"
        android:contentDescription="@string/smartbar__quick_action_toggle__alt"
        android:src="@drawable/ic_keyboard_arrow_right" />
    -->

    <!-- 候選詞容器：使用 RecyclerView 支援高效滑動 -->
    <LinearLayout
        android:id="@+id/candidates_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- 候選詞 RecyclerView：水平滑動，自動重用 View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/candidates_recycler_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <!-- 垂直分隔線：使用負的 start margin 讓它向左移動，與候選詞重疊 -->
        <View
            android:id="@+id/candidate_divider"
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="-40dp"
            android:layout_marginEnd="0dp"
            android:background="?android:attr/dividerVertical" />

        <!-- 展開/收合候選詞區塊的按鈕 -->
        <ImageButton
            android:id="@+id/expand_toggle_button"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4dp"
            android:background="?smartbar_bgColor"
            android:foreground="?android:attr/selectableItemBackground"
            android:contentDescription="@string/smartbar__expand_toggle__alt"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_keyboard_arrow_down"
            app:tint="?smartbar_fgColor" />

    </LinearLayout>

    <!-- 英文模式三欄式候選詞容器 -->
    <LinearLayout
        android:id="@+id/english_candidates_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <!-- 候選詞 1 -->
        <Button
            android:id="@+id/english_candidate_1"
            style="@style/SmartbarEnglishCandidate"
            android:text="" />

        <!-- 分隔線 1 -->
        <View
            android:id="@+id/english_divider_1"
            style="@style/SmartbarCandidateDivider" />

        <!-- 候選詞 2 -->
        <Button
            android:id="@+id/english_candidate_2"
            style="@style/SmartbarEnglishCandidate"
            android:text="" />

        <!-- 分隔線 2 -->
        <View
            android:id="@+id/english_divider_2"
            style="@style/SmartbarCandidateDivider" />

        <!-- 候選詞 3 -->
        <Button
            android:id="@+id/english_candidate_3"
            style="@style/SmartbarEnglishCandidate"
            android:text="" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/quick_actions"
        style="@style/SmartbarContainer"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <com.siansiansu.taigikeyboard.ime.text.smartbar.SmartbarQuickActionButton
            android:id="@+id/quick_action_open_settings"
            style="@style/SmartbarQuickAction"
            android:contentDescription="@string/smartbar__quick_action__open_settings"
            android:src="@drawable/ic_settings" />

        <!-- 輸入模式切換按鈕：POJ / TL / En -->
        <Button
            android:id="@+id/button_mode_poj"
            style="@style/SmartbarModeButton"
            android:text="POJ" />

        <Button
            android:id="@+id/button_mode_tl"
            style="@style/SmartbarModeButton"
            android:text="TL" />

        <Button
            android:id="@+id/button_mode_en"
            style="@style/SmartbarModeButton"
            android:text="En" />

    </LinearLayout>

    <!-- TODO: integrate a KeyboardView instead of hardcoding these buttons -->
    <LinearLayout
        android:id="@+id/number_row"
        style="@style/SmartbarContainer"
        android:visibility="gone"
        tools:ignore="HardcodedText">

        <Button
            android:id="@+id/number_row_1"
            style="@style/SmartbarCandidate"
            android:text="1" />

        <Button
            android:id="@+id/number_row_2"
            style="@style/SmartbarCandidate"
            android:text="2" />

        <Button
            android:id="@+id/number_row_3"
            style="@style/SmartbarCandidate"
            android:text="3" />

        <Button
            android:id="@+id/number_row_4"
            style="@style/SmartbarCandidate"
            android:text="4" />

        <Button
            android:id="@+id/number_row_5"
            style="@style/SmartbarCandidate"
            android:text="5" />

        <Button
            android:id="@+id/number_row_6"
            style="@style/SmartbarCandidate"
            android:text="6" />

        <Button
            android:id="@+id/number_row_7"
            style="@style/SmartbarCandidate"
            android:text="7" />

        <Button
            android:id="@+id/number_row_8"
            style="@style/SmartbarCandidate"
            android:text="8" />

        <Button
            android:id="@+id/number_row_9"
            style="@style/SmartbarCandidate"
            android:text="9" />

        <Button
            android:id="@+id/number_row_0"
            style="@style/SmartbarCandidate"
            android:text="0" />

    </LinearLayout>

    <!-- Placeholder on the right which reserves the space for a second button -->
    <com.siansiansu.taigikeyboard.ime.text.smartbar.SmartbarQuickActionButton
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/smartbar_button_margin"
        android:clickable="false"
        android:visibility="gone" />

</com.siansiansu.taigikeyboard.ime.text.smartbar.SmartbarView>
