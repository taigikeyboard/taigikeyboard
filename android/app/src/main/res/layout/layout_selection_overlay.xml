<?xml version="1.0" encoding="utf-8"?>
<!-- Layout selection overlay: covers keyboard area with layout preview cards -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:id="@+id/layout_overlay_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?keyboard_bgColor"
        android:scrollbars="none"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Romanization keyboards -->
            <TextView
                android:id="@+id/layout_overlay_romanization_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="6dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textColor="?smartbar_fgColor"
                android:alpha="0.6" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/layout_overlay_romanization_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <!-- Section 2: Taigi phonetic -->
            <TextView
                android:id="@+id/layout_overlay_phonetic_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textColor="?smartbar_fgColor"
                android:alpha="0.6" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/layout_overlay_phonetic_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>

    </ScrollView>

</merge>
