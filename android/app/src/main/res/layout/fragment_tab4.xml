<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/modern_surface_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

        <!-- 頁面標題 -->
        <TextView
            android:id="@+id/text_tab_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/modern_text_primary"
            android:layout_marginBottom="24dp"
            tools:text="設定" />

        <!-- 輸入模式卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/input_mode_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/spyfamily_card_stroke"
            app:cardBackgroundColor="@color/modern_surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/text_input_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings__input_mode"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/modern_text_primary"
                    android:layout_marginBottom="20dp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/input_mode_toggle_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:saveEnabled="false"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedButton="@id/button_poj_mode">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_poj_mode"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings__poj_mode"
                        app:backgroundTint="@color/segmented_button_background"
                        android:textColor="@color/segmented_button_text"
                        app:strokeColor="@color/modern_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_tl_mode"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings__tl_mode"
                        app:backgroundTint="@color/segmented_button_background"
                        android:textColor="@color/segmented_button_text"
                        app:strokeColor="@color/modern_accent" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 字體設定卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/font_type_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/spyfamily_card_stroke"
            app:cardBackgroundColor="@color/modern_surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/text_custom_font"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings__custom_font"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/modern_text_primary"
                    android:layout_marginBottom="20dp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/font_type_toggle_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:saveEnabled="false"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedButton="@id/button_font_system">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_font_system"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings__font_system"
                        app:backgroundTint="@color/segmented_button_background"
                        android:textColor="@color/segmented_button_text"
                        app:strokeColor="@color/modern_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_font_huninn"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings__font_open_huninn"
                        app:backgroundTint="@color/segmented_button_background"
                        android:textColor="@color/segmented_button_text"
                        app:strokeColor="@color/modern_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_font_iansui"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings__font_iansui"
                        app:backgroundTint="@color/segmented_button_background"
                        android:textColor="@color/segmented_button_text"
                        app:strokeColor="@color/modern_accent" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 開關設定卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/spyfamily_card_stroke"
            app:cardBackgroundColor="@color/modern_surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 括號標註 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="12dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/text_output_both"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings__output_both_scripts"
                        android:textSize="16sp"
                        android:textColor="@color/modern_text_primary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_output_both"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false" />

                </LinearLayout>

                <View style="@style/ModernDivider"
                    android:layout_marginStart="60dp" />

                <!-- 自動大寫 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="12dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/text_auto_cap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings__auto_capitalization"
                        android:textSize="16sp"
                        android:textColor="@color/modern_text_primary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_auto_cap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false" />

                </LinearLayout>

                <View style="@style/ModernDivider"
                    android:layout_marginStart="60dp" />

                <!-- 自動空白 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="12dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/text_auto_space"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings__auto_space"
                        android:textSize="16sp"
                        android:textColor="@color/modern_text_primary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_auto_space"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false" />

                </LinearLayout>

                <View style="@style/ModernDivider"
                    android:layout_marginStart="60dp" />

                <!-- 連紲拍 oo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="12dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/text_double_oo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings__double_tap_oo"
                        android:textSize="16sp"
                        android:textColor="@color/modern_text_primary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_double_oo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false" />

                </LinearLayout>

                <View style="@style/ModernDivider"
                    android:layout_marginStart="60dp" />

                <!-- 連紲拍 nn -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="12dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/text_double_nn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings__double_tap_nn"
                        android:textSize="16sp"
                        android:textColor="@color/modern_text_primary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_double_nn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 重設設定卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/action_buttons_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/spyfamily_card_stroke"
            app:cardBackgroundColor="@color/modern_surface_card">

            <LinearLayout
                android:id="@+id/row_reset_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/text_reset_settings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings__reset_settings"
                    android:textSize="16sp"
                    android:textColor="@color/modern_accent_secondary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Debug Zone 卡片（僅 Debug 模式顯示） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_debug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/spyfamily_card_stroke"
            app:cardBackgroundColor="@color/modern_surface_card">

            <LinearLayout
                android:id="@+id/row_debug_zone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/text_debug_zone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings__debug_zone"
                    android:textSize="16sp"
                    android:textColor="@color/modern_text_primary" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/modern_text_secondary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
