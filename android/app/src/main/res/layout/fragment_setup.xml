<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/modern_surface_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Icon -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/keyboard_24"
            android:layout_marginBottom="32dp"
            android:contentDescription="@string/content_desc__icon_keyboard" />

        <!-- Title -->
        <TextView
            android:id="@+id/onboarding_setup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/modern_text_primary"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Privacy Message -->
        <TextView
            android:id="@+id/privacy_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/modern_text_secondary"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="32dp"
            android:gravity="center" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Go to Settings Button -->
        <Button
            android:id="@+id/btn_go_to_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingVertical="16dp"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

</ScrollView>
