<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/modern_surface_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

        <!-- 頁面標題 -->
        <TextView
            android:id="@+id/text_tab_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/modern_text_primary"
            android:layout_marginBottom="24dp"
            tools:text="齒佈" />

        <!-- 說明文字 -->
        <TextView
            android:id="@+id/text_layout_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/layout__description"
            android:textSize="16sp"
            android:textColor="@color/modern_text_secondary"
            android:layout_marginBottom="8dp" />

        <!-- 佈局選項卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            app:cardBackgroundColor="@color/modern_surface_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/spyfamily_card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- PhahTaigi 佈局 -->
                <LinearLayout
                    android:id="@+id/row_layout_phahtaigi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:gravity="center_vertical">

                    <!-- 預覽圖容器 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="180dp"
                        android:layout_height="120dp"
                        android:clickable="false"
                        android:focusable="false"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/spyfamily_card_stroke"
                        app:cardBackgroundColor="@color/modern_surface_secondary">

                        <!-- 預覽圖 -->
                        <ImageView
                            android:id="@+id/preview_phahtaigi"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/layout_phahtaigi_preview" />

                        <!-- 選中遮罩 -->
                        <View
                            android:id="@+id/overlay_phahtaigi"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#4D000000"
                            android:visibility="gone" />

                        <!-- 選中勾選 -->
                        <FrameLayout
                            android:id="@+id/checkmark_phahtaigi"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:background="@drawable/circle_accent"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_done"
                                app:tint="@android:color/white" />

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- 標題 -->
                    <TextView
                        android:id="@+id/text_layout_phahtaigi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="@string/layout__phahtaigi"
                        android:textSize="16sp"
                        android:textColor="@color/modern_text_primary"
                        android:gravity="center" />

                </LinearLayout>

                <View style="@style/ModernDivider"
                    android:layout_marginStart="16dp" />

                <!-- 標準佈局 -->
                <LinearLayout
                    android:id="@+id/row_layout_standard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:gravity="center_vertical">

                    <!-- 預覽圖容器 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="180dp"
                        android:layout_height="120dp"
                        android:clickable="false"
                        android:focusable="false"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/spyfamily_card_stroke"
                        app:cardBackgroundColor="@color/modern_surface_secondary">

                        <!-- 預覽圖 -->
                        <ImageView
                            android:id="@+id/preview_standard"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/layout_standard_preview" />

                        <!-- 選中遮罩 -->
                        <View
                            android:id="@+id/overlay_standard"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#4D000000"
                            android:visibility="gone" />

                        <!-- 選中勾選 -->
                        <FrameLayout
                            android:id="@+id/checkmark_standard"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:background="@drawable/circle_accent"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_done"
                                app:tint="@android:color/white" />

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- 標題 -->
                    <TextView
                        android:id="@+id/text_layout_standard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="@string/layout__standard"
                        android:textSize="16sp"
                        android:textColor="@color/modern_text_primary"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
