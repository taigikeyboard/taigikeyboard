<?xml version="1.0" encoding="utf-8"?>
<!-- 單個候選詞項目 layout，用於 RecyclerView -->
<!-- Title and subtitle vertically stacked (matching iOS CandidateButtonView) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/candidate_container"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/candidate_button_background"
    android:clickable="true"
    android:focusable="true"
    android:minWidth="64dp">

    <TextView
        android:id="@+id/candidate_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAllCaps="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        tools:text="tsi̍t" />

    <TextView
        android:id="@+id/candidate_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAllCaps="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        tools:text="一" />

</LinearLayout>
