<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/modern_surface_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp"
        android:paddingTop="100dp">

        <!-- Navigation Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/navigation_card"
            style="@style/ModernCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/home_navigation_item_setup" />
                <View style="@style/ModernDivider" />
                <include layout="@layout/home_navigation_item_settings" />
                <View style="@style/ModernDivider" />
                <include layout="@layout/home_navigation_item_website_intro" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Resources Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resources_card"
            style="@style/ModernCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/home_resource_item_contact" />
                <View style="@style/ModernDivider" />
                <include layout="@layout/home_resource_item_rate" />
                <View style="@style/ModernDivider" />
                <include layout="@layout/home_resource_item_share" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Copyright Section (單獨區塊) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/copyright_card"
            style="@style/ModernCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/home_navigation_item_copyright" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Footer Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="48dp"
            android:paddingHorizontal="20dp"
            android:gravity="center">

            <View
                android:layout_width="48dp"
                android:layout_height="6dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/footer_decoration_line" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home__footer__copyright"
                android:textSize="12sp"
                android:textColor="@color/modern_text_secondary"
                android:gravity="center"
                android:alpha="0.7" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
