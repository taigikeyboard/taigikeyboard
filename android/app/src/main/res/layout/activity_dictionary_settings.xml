<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/modern_surface_primary"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/modern_surface_primary"
        android:elevation="0dp"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/modern_surface_primary"
            app:titleTextColor="@color/modern_text_primary"
            app:navigationIconTint="@color/modern_text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- 詞庫列表 Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dictionary_list_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/spyfamily_card_stroke"
                app:cardBackgroundColor="@color/modern_surface_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 1. 教育部臺灣台語常用詞辭典 -->
                    <include layout="@layout/settings_toggle_item"
                        android:id="@+id/toggle_moe_dict" />

                    <View style="@style/ModernDivider"
                        android:layout_marginStart="60dp" />

                    <!-- 2. 台語新詞辭庫 -->
                    <include layout="@layout/settings_toggle_item"
                        android:id="@+id/toggle_newword_dict" />

                    <View style="@style/ModernDivider"
                        android:layout_marginStart="60dp" />

                    <!-- 3. 台語工藝詞庫 -->
                    <include layout="@layout/settings_toggle_item"
                        android:id="@+id/toggle_kungge_dict" />

                    <View style="@style/ModernDivider"
                        android:layout_marginStart="60dp" />

                    <!-- 4. iTaigi 華台對照典 -->
                    <include layout="@layout/settings_toggle_item"
                        android:id="@+id/toggle_itaigi_dict" />

                    <View style="@style/ModernDivider"
                        android:layout_marginStart="60dp" />

                    <!-- 5. 台日大辭典 -->
                    <include layout="@layout/settings_toggle_item"
                        android:id="@+id/toggle_taiwan_japan_dict" />

                    <View style="@style/ModernDivider"
                        android:layout_marginStart="60dp" />

                    <!-- 6. 台華線頂對照典 -->
                    <include layout="@layout/settings_toggle_item"
                        android:id="@+id/toggle_tai_hua_dict" />

                    <View style="@style/ModernDivider"
                        android:layout_marginStart="60dp" />

                    <!-- 7. 台灣植物名彙 -->
                    <include layout="@layout/settings_toggle_item"
                        android:id="@+id/toggle_taiwan_plant_dict" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 自訂詞庫 Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/custom_dictionary_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/spyfamily_card_stroke"
                app:cardBackgroundColor="@color/modern_surface_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 標題列：自訂詞庫 + 新增按鈕 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/section_title_custom_dictionary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/modern_text_primary" />

                        <!-- 新增按鈕 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_word"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+"
                            android:textSize="20sp"
                            android:textColor="@color/modern_accent"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:padding="0dp"
                            app:rippleColor="@color/modern_accent_container" />

                    </LinearLayout>

                    <!-- 空狀態提示 -->
                    <TextView
                        android:id="@+id/text_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingVertical="32dp"
                        android:textSize="14sp"
                        android:textColor="@color/modern_text_secondary"
                        android:visibility="gone" />

                    <!-- 詞條列表 -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_custom_words"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 清除資料 Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/clear_cache_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/spyfamily_card_stroke"
                app:cardBackgroundColor="@color/modern_surface_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/settings_action_item"
                        android:id="@+id/action_clear_cache" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
