<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/resource_item_sponsorship"
    style="@style/ModernNavigationItem"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- 左側復古色條（深紅強調重要性） -->
    <View
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="20dp"
        android:background="@color/modern_accent_secondary" />

    <TextView
        android:id="@+id/resource_sponsorship_title"
        style="@style/ModernTitleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/home__resource__sponsorship" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_arrow_forward"
        android:contentDescription="@string/content_desc__icon_arrow_forward"
        android:tint="@color/modern_text_secondary"
        android:alpha="0.5" />

</LinearLayout>
