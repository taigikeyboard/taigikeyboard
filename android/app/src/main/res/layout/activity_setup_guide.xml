<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/modern_surface_primary"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/modern_surface_primary"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/modern_text_primary"
            app:titleTextColor="@color/modern_text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="40dp">

            <!-- 說明文字 -->
            <TextView
                android:id="@+id/setup_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textColor="@color/modern_text_primary"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="24dp" />

            <!-- 步驟卡片容器 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- 步驟 1 卡片 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/modern_surface_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- 步驟編號和標題 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:text="1"
                                android:textSize="14sp"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:background="@drawable/circle_number_background" />

                            <TextView
                                android:id="@+id/step1_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:textSize="17sp"
                                android:textColor="@color/modern_text_primary" />

                        </LinearLayout>

                        <!-- 步驟 1 截圖 -->
                        <ImageView
                            android:id="@+id/step1_screenshot"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:scaleType="fitCenter"
                            android:src="@drawable/setup_step1"
                            android:contentDescription="@string/content_desc__step1_screenshot" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- 步驟 2 卡片 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/modern_surface_card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- 步驟編號和標題 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:text="2"
                                android:textSize="14sp"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:background="@drawable/circle_number_background" />

                            <TextView
                                android:id="@+id/step2_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:textSize="17sp"
                                android:textColor="@color/modern_text_primary" />

                        </LinearLayout>

                        <!-- 步驟 2 截圖 -->
                        <ImageView
                            android:id="@+id/step2_screenshot"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:scaleType="fitCenter"
                            android:src="@drawable/setup_step2"
                            android:contentDescription="@string/content_desc__step2_screenshot" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- 完成說明文字 -->
                <TextView
                    android:id="@+id/completed_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textColor="@color/modern_text_primary"
                    android:lineSpacingMultiplier="1.3" />

            </LinearLayout>

            <!-- 前往設定按鈕 -->
            <Button
                android:id="@+id/btn_go_to_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingVertical="16dp"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.Button" />

            <!-- 警告訊息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/modern_accent"
                    android:contentDescription="@string/content_desc__icon_warning" />

                <TextView
                    android:id="@+id/privacy_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="17sp"
                    android:textColor="@color/modern_text_primary"
                    android:lineSpacingMultiplier="1.3" />

            </LinearLayout>

            <!-- 手機品牌警告訊息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/modern_accent"
                    android:contentDescription="@string/content_desc__icon_warning" />

                <TextView
                    android:id="@+id/brand_warning_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="17sp"
                    android:textColor="@color/modern_text_primary"
                    android:lineSpacingMultiplier="1.3" />

            </LinearLayout>

            <!-- 關閉按鈕（僅全螢幕模式顯示） -->
            <Button
                android:id="@+id/btn_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/modern_accent_secondary"
                android:visibility="gone"
                app:icon="@drawable/ic_close"
                app:iconTint="@android:color/white"
                app:iconGravity="textStart"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
