<?xml version="1.0" encoding="utf-8"?>
<!-- Settings selection overlay: covers keyboard area with settings toggles -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?keyboard_bgColor">

        <!-- Scrollable settings area -->
        <ScrollView
            android:id="@+id/settings_overlay_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <!-- General section -->
                <TextView
                    android:id="@+id/settings_overlay_general_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="?smartbar_fgColor"
                    android:alpha="0.6" />

                <!-- Output Both Scripts -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/settings_overlay_label_output_both"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        android:textColor="?smartbar_fgColor" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/settings_overlay_switch_output_both"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_blue"
                        app:trackTint="@color/switch_track_blue" />

                </LinearLayout>

                <!-- Auto Capitalization -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/settings_overlay_label_auto_cap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        android:textColor="?smartbar_fgColor" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/settings_overlay_switch_auto_cap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_blue"
                        app:trackTint="@color/switch_track_blue" />

                </LinearLayout>

                <!-- Auto Space -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/settings_overlay_label_auto_space"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        android:textColor="?smartbar_fgColor" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/settings_overlay_switch_auto_space"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_blue"
                        app:trackTint="@color/switch_track_blue" />

                </LinearLayout>

                <!-- Toolbar Auto Collapse -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/settings_overlay_label_toolbar_collapse"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        android:textColor="?smartbar_fgColor" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/settings_overlay_switch_toolbar_collapse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_blue"
                        app:trackTint="@color/switch_track_blue" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="16dp"
                    android:background="?smartbar_fgColor"
                    android:alpha="0.15" />

                <!-- POJ section -->
                <TextView
                    android:id="@+id/settings_overlay_poj_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="?smartbar_fgColor"
                    android:alpha="0.6" />

                <!-- Double Tap OO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/settings_overlay_label_double_oo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        android:textColor="?smartbar_fgColor" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/settings_overlay_switch_double_oo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_blue"
                        app:trackTint="@color/switch_track_blue" />

                </LinearLayout>

                <!-- Double Tap NN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/settings_overlay_label_double_nn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        android:textColor="?smartbar_fgColor" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/settings_overlay_switch_double_nn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_blue"
                        app:trackTint="@color/switch_track_blue" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="16dp"
                    android:background="?smartbar_fgColor"
                    android:alpha="0.15" />

                <!-- TPS section -->
                <TextView
                    android:id="@+id/settings_overlay_tps_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="?smartbar_fgColor"
                    android:alpha="0.6" />

                <!-- TPS or maps to ER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/settings_overlay_label_tps_or_er"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        android:textColor="?smartbar_fgColor" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/settings_overlay_switch_tps_or_er"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_blue"
                        app:trackTint="@color/switch_track_blue" />

                </LinearLayout>

                <!-- Open App link -->
                <TextView
                    android:id="@+id/settings_overlay_open_app_button"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textColor="?key_enter_bgColor"
                    android:textAllCaps="false"
                    android:background="?attr/selectableItemBackground" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</merge>
