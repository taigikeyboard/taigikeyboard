<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Direct Vibrator key-press haptics (KeyPressVibrator) so the in-app
         vibration toggle decides, independent of the OS touch-haptic setting.
         VIBRATE is a normal permission, auto-granted at install. -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!--
      Backup posture (R7 — INVARIANT_USER_DATA_EXCLUDED_FROM_OS_BACKUP,
      docs/architecture/behavioral-invariants.md §29):
      allowBackup="false" disables Android Auto Backup + device-transfer entirely,
      so the user-data DBs (user_frequency / user_association / custom_dictionary)
      never leave the device automatically. Learned + user-authored typing data
      stays on-device; cross-device portability is the manual `.taigi` export only.
      backup_rules.xml / data_extraction_rules.xml below exclude-everything as
      defense-in-depth if backup is ever re-enabled.
      Mirrors iOS SQLiteConnectionManager.excludeFromOSBackup.
    -->
    <application
        android:name=".TaigiKeyboardApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/SettingsTheme">

        <!-- IME service -->
        <service
            android:name="com.siansiansu.taigikeyboard.ime.core.TaigiKeyboard"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:configChanges="uiMode"
            android:exported="true">
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method"/>

            <intent-filter>
                <action android:name="android.view.InputMethod"/>
            </intent-filter>
        </service>

        <!-- Settings Activity -->
        <activity
            android:name="com.siansiansu.taigikeyboard.settings.SettingsMainActivity"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/settings__title"
            android:launchMode="singleTask"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:theme="@style/SettingsTheme"
            android:exported="true"/>

        <!-- Using an activity alias to disable/enable the app icon in the launcher -->
        <activity-alias
            android:name="com.siansiansu.taigikeyboard.SettingsLauncherAlias"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity="com.siansiansu.taigikeyboard.settings.SettingsMainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Copyright Activity -->
        <activity
            android:name="com.siansiansu.taigikeyboard.settings.CopyrightActivity"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/copyright__title"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:theme="@style/SettingsTheme"
            android:parentActivityName="com.siansiansu.taigikeyboard.settings.SettingsMainActivity"
            android:exported="false"/>

        <!-- Detail Activity -->
        <activity
            android:name="com.siansiansu.taigikeyboard.settings.DetailActivity"
            android:theme="@style/SettingsTheme"
            android:parentActivityName="com.siansiansu.taigikeyboard.settings.SettingsMainActivity"
            android:exported="false"/>

        <!-- Theme Editor Activity (custom-theme CRUD) -->
        <activity
            android:name="com.siansiansu.taigikeyboard.settings.ThemeEditorActivity"
            android:label="@string/tab_theme"
            android:theme="@style/SettingsTheme"
            android:parentActivityName="com.siansiansu.taigikeyboard.settings.SettingsMainActivity"
            android:exported="false"/>

        <!-- Custom Dictionary Activity -->
        <activity
            android:name="com.siansiansu.taigikeyboard.settings.CustomDictionaryActivity"
            android:theme="@style/SettingsTheme"
            android:parentActivityName="com.siansiansu.taigikeyboard.settings.SettingsMainActivity"
            android:exported="false"/>

        <!-- Data Management Activity (Backup/Restore) -->
        <activity
            android:name="com.siansiansu.taigikeyboard.settings.DataManagementActivity"
            android:theme="@style/SettingsTheme"
            android:parentActivityName="com.siansiansu.taigikeyboard.settings.SettingsMainActivity"
            android:exported="false"/>

        <!-- Frequent Words Activity (Frequency data) -->
        <activity
            android:name="com.siansiansu.taigikeyboard.settings.FrequentWordsActivity"
            android:theme="@style/SettingsTheme"
            android:parentActivityName="com.siansiansu.taigikeyboard.settings.SettingsMainActivity"
            android:exported="false"/>

        <!-- Setup Guide Activity -->
        <activity
            android:name="com.siansiansu.taigikeyboard.settings.SetupGuideActivity"
            android:theme="@style/SettingsTheme"
            android:parentActivityName="com.siansiansu.taigikeyboard.settings.SettingsMainActivity"
            android:exported="false"/>

    </application>

</manifest>
