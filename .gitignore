# === Gradle ===
.gradle/
# Sandboxed GRADLE_USER_HOME (Claude Code bash redirects gradle downloads here
# instead of polluting ~/.gradle/). Empty wrapper/dists/ leftovers are harmless.
.gradle-home/

# === Dictionary pipeline ===
# Build/run logs from dictionary/ Python pipeline (build.sh, run.sh).
dictionary/**/logs/

# === Rust ===
/engine/target/
**/*.rs.bk
Cargo.lock.bak

# === D9.2 — Rust shared-core platform artifacts ===
# Android Rust .so (engine/scripts/build-android-libs.sh) AND iOS xcframework .a
# are BOTH committed so a release tag carries a complete, buildable engine on
# both platforms. The global *.so rule above would ignore the Android libs, so
# they are explicitly re-included here. iOS xcframework + bridge .swift live
# under ios/RustEngine/ for stable Xcode source references (R3-H3 fix); the
# macOS counterpart lives under macos/RustEngine/ for a stable SwiftPM
# binaryTarget path (no ignore rule matches it, so no re-include needed).
!android/app/src/main/jniLibs/**/*.so

# === SwiftPM build cache (macOS input method) ===
# `.build/` holds compiled products, the assembled `.app` from
# macos/scripts/bundle-app.sh, and the signed installer packages from
# macos/scripts/release-app.sh; `Package.resolved` is committed.
macos/.build/
macos/.swiftpm/

# === Xcode build cache ===
# DerivedData lives outside the repo by default, but xcodebuild with
# `-derivedDataPath build/` (or a script that does) drops XCBuildData here.
ios/build/

# === Claude Code ===
.claude/settings.local.json
.claude/projects/
.claude/scheduled_tasks.lock

# top-level cloned IME repos only — anchored so it does NOT match docs/references/ or spec/references
/references/
.tmp/
client_secret.json
# === Windows input method (windows/ Cargo workspace) ===
windows/target/
# `.build/` holds the staged install layout and the installer that
# windows/scripts/release-app.sh produces — the macOS side's `macos/.build/`,
# and it must be ignored for the same reason: the script refuses a dirty tree,
# so its own output would make the next release un-cuttable.
windows/.build/
